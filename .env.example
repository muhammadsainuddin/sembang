# Copy to .env, edit privately, then chmod 600 .env.
# Local development: npm start (127.0.0.1:3000, no outbound email).
# Production: docker compose up -d --build after configuration.
SEMBANG_DOMAIN=private.aigeo.my
# Generate: openssl rand -hex 32
AUTH_SECRET=
# Gmail SMTP with STARTTLS. Use a dedicated Google App Password, not the
# normal Google account password. Enter the new secret only in the server .env.
# TLS certificate validation stays enabled. No email contents/OTP in logs.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mscreative.my@gmail.com
SMTP_PASSWORD=
SMTP_FROM='Zbuddy <mscreative.my@gmail.com>'
USER_STORAGE_MB=256
TOTAL_STORAGE_MB=4096
MIN_FREE_DISK_MB=512
UPLOAD_PENDING_HOURS=24
MAX_USER_MESSAGES=50000
MAX_TOTAL_MESSAGES=500000
MAX_CONVERSATIONS=500
SESSION_HOURS=168
MAX_ACTIVE_SESSIONS=50
REGISTRATION_ENABLED=true
MAX_USERS=100
# The first account is the Owner. New accounts require Owner approval after email verification.
ACCOUNT_APPROVAL_REQUIRED=true
# Gaya peta MapLibre. OpenFreeMap tidak memerlukan API key.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Identiti hubungan Web Push. Kunci VAPID dijana sekali dalam volume data.
VAPID_SUBJECT=mailto:mscreative.my@gmail.com
# Absolute path to the Firebase Admin service-account JSON on the server.
# Download it from Firebase Console > Project settings > Service accounts.
FIREBASE_SERVICE_ACCOUNT_FILE=
# Docker/Compose alternative: base64 -w0 firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Optional TURN provider / coturn REST shared secret (4-hour credentials).
TURN_URL=
TURN_SHARED_SECRET=
# Legacy static TURN credentials, if your provider requires them instead:
TURN_USERNAME=
TURN_CREDENTIAL=
# Change these together only if the subnet conflicts with your VPS networks.
SEMBANG_SUBNET=172.29.241.0/24
CADDY_IP=172.29.241.2
# Existing installations: set the EXACT original Docker data volume here.
SEMBANG_DATA_VOLUME=sembang_data
