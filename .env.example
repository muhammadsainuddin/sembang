# Copy to .env, edit privately, then chmod 600 .env.
# Local development: npm start (127.0.0.1:3000, no outbound email).
# Production: docker compose up -d --build after configuration.
SEMBANG_DOMAIN=private.aigeo.my
# Generate: openssl rand -hex 32
AUTH_SECRET=
# Use your SMTP provider. 587 = STARTTLS; 465 = SMTP_SECURE=true.
# TLS certificate validation stays enabled. No email contents/OTP in logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
USER_STORAGE_MB=256
TOTAL_STORAGE_MB=4096
MIN_FREE_DISK_MB=512
UPLOAD_PENDING_HOURS=24
MAX_USER_MESSAGES=50000
MAX_TOTAL_MESSAGES=500000
MAX_CONVERSATIONS=500
SESSION_HOURS=168
REGISTRATION_ENABLED=true
# Optional TURN provider / coturn REST shared secret (4-hour credentials).
TURN_URL=
TURN_SHARED_SECRET=
# Legacy static TURN credentials, if your provider requires them instead:
TURN_USERNAME=
TURN_CREDENTIAL=
# Change these together only if the subnet conflicts with your VPS networks.
SEMBANG_SUBNET=172.29.241.0/24
CADDY_IP=172.29.241.2
# Existing installations: set the EXACT original Docker data volume here.
SEMBANG_DATA_VOLUME=sembang_data
