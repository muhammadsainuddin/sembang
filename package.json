{
  "name": "sembang",
  "version": "1.4.0",
  "private": true,
  "description": "Chat, images, voice and video calls, and live location with JavaScript and Node.js",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "android:build": "node scripts/android-build.mjs",
    "android:check": "node scripts/android-build.mjs --check",
    "server:package": "node scripts/package-server.mjs",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.2",
    "multer": "^2.0.2",
    "nodemailer": "^10.3.1",
    "proxy-addr": "^2.0.8",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
